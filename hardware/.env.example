# Copy these names into your hosting provider's environment-variable settings.
# Spring Boot does not load .env files by itself.
APP_ADMIN_EMAIL=you@example.com
APP_ADMIN_PASSWORD_HASH=$2a$12$replace_with_a_bcrypt_hash_generated_locally
APP_ALLOWED_ORIGINS=http://localhost:5173

# Required only with SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://host:5432/database
DATABASE_USERNAME=least_privilege_application_user
DATABASE_PASSWORD=replace_with_a_secret
