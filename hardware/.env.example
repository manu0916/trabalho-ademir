SPRING_PROFILES_ACTIVE=supabase
APP_ADMIN_EMAIL=admin@sua-loja.example
# BCrypt hash only; never place the plaintext password here.
APP_ADMIN_PASSWORD_HASH=$2a$12$SUBSTITUA_POR_UM_HASH_BCRYPT_VALIDO
# Optional but recommended in production: generate a private random value with 32+ characters.
APP_ADMIN_ACCESS_TOKEN_SECRET=
APP_ALLOWED_ORIGINS=https://sua-loja.example
SUPABASE_DB_URL=jdbc:postgresql://db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=COLE_A_SENHA_DO_BANCO_AQUI
# Use sk_test_... and whsec_... in test environments. Never commit live credentials.
STRIPE_SECRET_KEY=sk_test_SUBSTITUA_PELA_CHAVE_SECRETA
STRIPE_WEBHOOK_SECRET=whsec_SUBSTITUA_PELO_SEGREDO_DO_ENDPOINT
# Stripe replaces this literal placeholder after Checkout completes.
STRIPE_SUCCESS_URL=https://sua-loja.example/pagamento/sucesso?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://sua-loja.example/pagamento/cancelado
# Optional: Stripe Checkout accepts 30 to 1440 minutes; the application clamps this range.
STRIPE_CHECKOUT_EXPIRES_MINUTES=30
# Expiration of payment instructions after the hosted form is completed.
STRIPE_PIX_EXPIRES_MINUTES=30
STRIPE_BOLETO_EXPIRES_DAYS=1
# false with sk_test/whsec test endpoint; true only with live credentials/endpoints.
STRIPE_LIVE_MODE=false
STRIPE_RECONCILIATION_INTERVAL_MS=60000
# Add PIX only after Stripe confirms the Pix capability on this account.
STRIPE_PAYMENT_METHODS=CARTAO_CREDITO,BOLETO
